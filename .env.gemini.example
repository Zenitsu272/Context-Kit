# Copy to .env.gemini.local. Import that file in Context Kit > Settings.
# Keys are NEVER bundled by Vite or committed. Do not use VITE_ for secrets.
GEMINI_API_KEY_1=replace_with_your_first_key
GEMINI_API_KEY_2=replace_with_your_backup_key
# Alternatively: GEMINI_API_KEYS=first_key,second_key
GEMINI_MODEL=gemini-3.5-flash-lite
